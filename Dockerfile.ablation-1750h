FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

# System deps for audio
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir onnxruntime onnxscript
RUN pip install --no-cache-dir 'datasets<4' librosa soundfile

# Copy project
COPY src/ src/
COPY app.py .
COPY recipes.yaml .

# Ablation on full 1750h cache (all shards, no --max-samples)
# Same 11M architecture as smol, just 17x more data
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
CMD ["python", "-u", "app.py", "train", \
    "--from-cache", "tisaconundrum/grassmann-mel-cache", \
    "--epochs", "50", \
    "--batch-size", "32", \
    "--layers", "6", \
    "--d-model", "256", \
    "--r-reduced", "32", \
    "--lr", "3e-4", \
    "--ctc", \
    "--conformer", \
    "--two-sided", \
    "--ablation", \
    "--run-name", "ablation-1750h", \
    "--save-dir", "checkpoints", \
    "--decode-every", "5"]
